diff --git test/bats_helper.bash test/bats_helper.bash
index 24c93d48..859932ef 100644
--- test/bats_helper.bash
+++ test/bats_helper.bash
@@ -21,3 +21,46 @@ bats::on_failure() {
     printf "═══════════════════════════════════════════════════════════════════════════════\n"
     printf "\n"
 }
+
+# Runs a shell command as user pihole. FreeBSD's su has no -s (and -c names a
+# login class there), -m keeps the caller's shell instead
+as_pihole() {
+    if [[ "$(uname -s)" == "FreeBSD" ]]; then
+        su -m pihole -c "$1"
+    else
+        su pihole -s /bin/sh -c "$1"
+    fi
+}
+export -f as_pihole
+
+# Name of the loopback interface
+LO="lo"
+[[ "$(uname -s)" == "FreeBSD" ]] && LO="lo0"
+export LO
+
+# The command line of process $1, its arguments separated by spaces
+proc_cmdline() {
+    if [[ -r "/proc/$1/cmdline" ]]; then
+        tr '\0' ' ' < "/proc/$1/cmdline"
+    else
+        ps -ww -o args= -p "$1"
+    fi
+}
+export -f proc_cmdline
+
+# Is a TCP socket listening on port $1?
+tcp_listening() {
+    if [[ "$(uname -s)" == "FreeBSD" ]]; then
+        sockstat -46lq -P tcp | awk '{ print $6 }' | grep -q ":$1\$"
+    else
+        netstat -ltn | grep -q ":$1 "
+    fi
+}
+export -f tcp_listening
+
+# Settings for the tests that name clients through dns.hosts. FreeBSD only sends
+# from the client addresses lo0 has, which makes them local, and FTL answers the
+# PTR query of a local address with pi.hole (dns.piholePTR) before dns.hosts
+CLIENT_NAMES_ENV=""
+[[ "$(uname -s)" == "FreeBSD" ]] && CLIENT_NAMES_ENV="FTLCONF_dns_piholePTR=NONE"
+export CLIENT_NAMES_ENV
