From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sarahmeow1986 <saretta1986@proton.me>
Date: Sat, 31 Oct 2026 16:57:01 +0100
Subject: [PATCH] Serve HTTP/3 on an IPv4 address from an IPv4 socket off Linux

---
 src/webserver/terminator.c | 40 ++++++++++++++++++++++++++++----------
 1 file changed, 30 insertions(+), 10 deletions(-)

diff --git src/webserver/terminator.c src/webserver/terminator.c
index 13d3cf8c..033b7d08 100644
--- src/webserver/terminator.c
+++ src/webserver/terminator.c
@@ -4212,7 +4212,31 @@ static SSL_CTX *create_quic_server_ctx(const char *cert_path)
 // Bind the UDP socket for the QUIC listener, scoped like bind_listener().
 static int bind_udp(const char *addr, int port, bool optional)
 {
-	const int fd = socket(AF_INET6, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+	struct sockaddr_in6 sa;
+	if(!fill_bind_addr(&sa, addr, port))
+	{
+		log_err("Terminator: invalid QUIC bind address '%s'", addr);
+		return -1;
+	}
+	struct sockaddr *bind_sa = (struct sockaddr *)&sa;
+	socklen_t bind_len = sizeof(sa);
+#ifndef __linux__
+	// The BSDs refuse the replies OpenSSL sends from an IPv6 socket bound to an
+	// IPv4-mapped address (sendmsg(): EAFNOSUPPORT): an IPv4 address gets an
+	// IPv4 socket
+	struct sockaddr_in sa4;
+	if(IN6_IS_ADDR_V4MAPPED(&sa.sin6_addr))
+	{
+		memset(&sa4, 0, sizeof(sa4));
+		sa4.sin_family = AF_INET;
+		sa4.sin_port = sa.sin6_port;
+		memcpy(&sa4.sin_addr, &sa.sin6_addr.s6_addr[12], sizeof(sa4.sin_addr));
+		bind_sa = (struct sockaddr *)&sa4;
+		bind_len = sizeof(sa4);
+	}
+#endif
+
+	const int fd = socket(bind_sa->sa_family, SOCK_DGRAM | SOCK_CLOEXEC, 0);
 	if(fd < 0)
 	{
 		log_err("Terminator: QUIC socket() failed: %s", strerror(errno));
@@ -4221,17 +4245,13 @@ static int bind_udp(const char *addr, int port, bool optional)
 	const int on = 1;
 	setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
 	// Same IPv4/IPv6 scoping rule as the TCP listener above.
-	const int v6only = addr_is_v6_literal(addr) ? 1 : 0;
-	setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &v6only, sizeof(v6only));
-
-	struct sockaddr_in6 sa;
-	if(!fill_bind_addr(&sa, addr, port))
+	if(bind_sa->sa_family == AF_INET6)
 	{
-		log_err("Terminator: invalid QUIC bind address '%s'", addr);
-		close(fd);
-		return -1;
+		const int v6only = addr_is_v6_literal(addr) ? 1 : 0;
+		setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &v6only, sizeof(v6only));
 	}
-	if(bind(fd, (struct sockaddr *)&sa, sizeof(sa)) != 0)
+
+	if(bind(fd, bind_sa, bind_len) != 0)
 	{
 		if(optional)
 			log_info("Terminator: optional HTTP/3 port %s#%d not available: %s",
