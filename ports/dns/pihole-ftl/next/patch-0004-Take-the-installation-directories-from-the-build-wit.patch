 13 files changed, 77 insertions(+), 32 deletions(-)

diff --git CMakeLists.txt CMakeLists.txt
index 9a7b3cc1..5324030e 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -21,23 +21,44 @@ set(DNSMASQ_VERSION pi-hole-v2.93+35)
 # Base directory holding Pi-hole's configuration and state (pihole.toml,
 # dnsmasq.conf, the databases, ...). Packagers can relocate the whole tree with
 #   cmake -DPIHOLE_INSTALL_DIR=/opt/pihole/etc ...
-# The default matches the historical hardcoded location. This is a build-time
-# knob only and does not add a runtime override.
-set(PIHOLE_INSTALL_DIR "/etc/pihole" CACHE STRING "Base directory for Pi-hole configuration and state")
-if(NOT PIHOLE_INSTALL_DIR MATCHES "^/")
-    message(FATAL_ERROR "PIHOLE_INSTALL_DIR must be an absolute path, got \"${PIHOLE_INSTALL_DIR}\"")
+# The default matches the historical hardcoded location, or the platform's own
+# layout where third-party software lives under /usr/local (FreeBSD). This is
+# a build-time knob only and does not add a runtime override. The log
+# directory, the web interface's document root and the additional dnsmasq
+# configuration directory can be relocated the same way.
+if(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
+    set(PIHOLE_INSTALL_DIR_DEFAULT "/usr/local/etc/pihole")
+    set(PIHOLE_WEBROOT_DEFAULT "/usr/local/www/pihole")
+    set(DNSMASQ_D_DIR_DEFAULT "/usr/local/etc/dnsmasq.d")
+else()
+    set(PIHOLE_INSTALL_DIR_DEFAULT "/etc/pihole")
+    set(PIHOLE_WEBROOT_DEFAULT "/var/www/html")
+    set(DNSMASQ_D_DIR_DEFAULT "/etc/dnsmasq.d")
 endif()
-if(PIHOLE_INSTALL_DIR MATCHES "/$")
-    message(FATAL_ERROR "PIHOLE_INSTALL_DIR must not end in a slash, got \"${PIHOLE_INSTALL_DIR}\"")
-endif()
-# Several log messages concatenate a path derived from this value straight into
-# a printf format string (e.g. main.c: log_info("Parsed config file "
-# GLOBALTOMLPATH " successfully")), so a percent sign here would be read as a
-# format specifier. Do not relax this without converting those call sites to
-# pass the path as an argument.
-if(PIHOLE_INSTALL_DIR MATCHES "%")
-    message(FATAL_ERROR "PIHOLE_INSTALL_DIR must not contain a percent sign, got \"${PIHOLE_INSTALL_DIR}\"")
-endif()
-add_compile_definitions(PIHOLE_INSTALL_DIR="${PIHOLE_INSTALL_DIR}")
+set(PIHOLE_INSTALL_DIR "${PIHOLE_INSTALL_DIR_DEFAULT}" CACHE STRING "Base directory for Pi-hole configuration and state")
+set(PIHOLE_LOGDIR "/var/log/pihole" CACHE STRING "Directory of Pi-hole's log files")
+set(PIHOLE_WEBROOT "${PIHOLE_WEBROOT_DEFAULT}" CACHE STRING "Document root of the web interface")
+set(DNSMASQ_D_DIR "${DNSMASQ_D_DIR_DEFAULT}" CACHE STRING "Additional dnsmasq configuration directory")
+# Several log messages concatenate these paths straight into a printf format
+# string (e.g. main.c: log_info("Parsed config file " GLOBALTOMLPATH
+# " successfully")), so a percent sign here would be read as a format
+# specifier. Do not relax this without converting those call sites to pass the
+# path as an argument.
+foreach(dir PIHOLE_INSTALL_DIR PIHOLE_LOGDIR PIHOLE_WEBROOT DNSMASQ_D_DIR)
+    if(NOT ${dir} MATCHES "^/")
+        message(FATAL_ERROR "${dir} must be an absolute path, got \"${${dir}}\"")
+    endif()
+    if(${dir} MATCHES "/$")
+        message(FATAL_ERROR "${dir} must not end in a slash, got \"${${dir}}\"")
+    endif()
+    if(${dir} MATCHES "%")
+        message(FATAL_ERROR "${dir} must not contain a percent sign, got \"${${dir}}\"")
+    endif()
+endforeach()
+add_compile_definitions(
+    PIHOLE_INSTALL_DIR="${PIHOLE_INSTALL_DIR}"
+    PIHOLE_LOGDIR="${PIHOLE_LOGDIR}"
+    PIHOLE_WEBROOT="${PIHOLE_WEBROOT}"
+    DNSMASQ_D_DIR="${DNSMASQ_D_DIR}")
 
 add_subdirectory(src)
