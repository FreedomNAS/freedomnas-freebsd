 src/api/info.c              |  3 ++-
 src/args.c                  | 11 ++++++-----
 src/config/config.c         | 27 ++++++++++++++-------------
 src/config/config.h         |  9 +++++----
 src/config/dnsmasq_config.c | 11 ++++++-----
 src/config/dnsmasq_config.h | 11 ++++++-----
