From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sarahmeow1986 <saretta1986@proton.me>
Date: Fri, 23 Oct 2026 11:39:50 +0200
Subject: [PATCH] Give pihole-FTL a PATH with /usr/local on FreeBSD

---
 advanced/Templates/pihole-FTL.rcd | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git advanced/Templates/pihole-FTL.rcd advanced/Templates/pihole-FTL.rcd
index 2d018784..2620c66b 100644
--- advanced/Templates/pihole-FTL.rcd
+++ advanced/Templates/pihole-FTL.rcd
@@ -28,6 +28,11 @@ load_rc_config $name
 : "${pihole_ftl_enable:=NO}"
 : "${pihole_ftl_user:=root}"
 
+# rc's PATH leaves out /usr/local: FTL runs the pihole scripts (bash) from
+# there, for gravity and the other actions of the web interface
+PATH="${PATH}:/usr/local/sbin:/usr/local/bin"
+export PATH
+
 PI_HOLE_SCRIPT_DIR="/opt/pihole"
 
 command="/usr/local/bin/pihole-FTL"
@@ -51,8 +56,7 @@ pihole_ftl_prestart()
 # install or upgrade ends with a (re)start, which is when it changes
 pihole_ftl_poststart()
 {
-	PATH="${PATH}:/usr/local/sbin:/usr/local/bin" /usr/local/bin/pihole updatechecker \
-		</dev/null >/dev/null 2>&1 &
+	/usr/local/bin/pihole updatechecker </dev/null >/dev/null 2>&1 &
 }
 
 pihole_ftl_poststop()
