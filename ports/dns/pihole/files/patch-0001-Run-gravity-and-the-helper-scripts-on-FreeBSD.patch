From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sarahmeow1986 <saretta1986@proton.me>
Date: Thu, 22 Oct 2026 06:02:15 +0200
Subject: [PATCH] Run gravity and the helper scripts on FreeBSD

---
 advanced/Scripts/list.sh        |  4 ++--
 advanced/Scripts/piholeDebug.sh |  2 +-
 advanced/Scripts/utils.sh       | 30 +++++++++++++++++++++++++++-
 gravity.sh                      | 35 ++++++++++++++++++++++-----------
 4 files changed, 56 insertions(+), 15 deletions(-)

diff --git advanced/Scripts/list.sh advanced/Scripts/list.sh
index c5a80ad2..2d2d4171 100755
--- advanced/Scripts/list.sh
+++ advanced/Scripts/list.sh
@@ -176,8 +176,8 @@ Displaylist() {
             echo -e "    - ${COL_BLUE}$(echo "${data}" | jq --compact-output ".domains[$i].domain")${COL_NC}"
             echo -e "      Comment: $(echo "${data}" | jq --compact-output ".domains[$i].comment")"
             echo -e "      Groups: $(echo "${data}" | jq --compact-output ".domains[$i].groups")"
-            echo -e "      Added: $(date -d @"$(echo "${data}" | jq --compact-output ".domains[$i].date_added")")"
-            echo -e "      Last modified: $(date -d @"$(echo "${data}" | jq --compact-output ".domains[$i].date_modified")")"
+            echo -e "      Added: $(date_from_epoch "$(echo "${data}" | jq --compact-output ".domains[$i].date_added")")"
+            echo -e "      Last modified: $(date_from_epoch "$(echo "${data}" | jq --compact-output ".domains[$i].date_modified")")"
         done
     else
         echo -e "  ${INFO} No domains found in the ${kindId} ${typeId}list"
diff --git advanced/Scripts/piholeDebug.sh advanced/Scripts/piholeDebug.sh
index 27c636e1..d14fc171 100755
--- advanced/Scripts/piholeDebug.sh
+++ advanced/Scripts/piholeDebug.sh
@@ -1109,7 +1109,7 @@ analyze_gravity_list() {
 
     show_db_entries "Info table" "SELECT property,value FROM info" "20 40"
     gravity_updated_raw="$(pihole-FTL sqlite3 -ni "${PIHOLE_GRAVITY_DB_FILE}" "SELECT value FROM info where property = 'updated'")"
-    gravity_updated="$(date -d @"${gravity_updated_raw}")"
+    gravity_updated="$(date_from_epoch "${gravity_updated_raw}")"
     log_write "   Last gravity run finished at: ${COL_CYAN}${gravity_updated}${COL_NC}"
     log_write ""
 
diff --git advanced/Scripts/utils.sh advanced/Scripts/utils.sh
index 22b5786f..5dfdd74e 100755
--- advanced/Scripts/utils.sh
+++ advanced/Scripts/utils.sh
@@ -32,7 +32,12 @@ addOrEditKeyValPair() {
 
   if grep -q "^${key}=" "${file}"; then
     # Key already exists in file, modify the value
-    sed -i "/^${key}=/c\\${key}=${value}" "${file}"
+    # awk instead of sed's c command, which GNU and BSD sed spell differently
+    local tmp
+    tmp="$(mktemp)" &&
+      awk -v k="${key}" -v v="${value}" 'index($0, k "=") == 1 {print k "=" v; next} {print}' "${file}" >"${tmp}" &&
+      cat "${tmp}" >"${file}"
+    rm -f "${tmp}"
   else
     # Key does not already exist, add it and it's value
     echo "${key}=${value}" >> "${file}"
@@ -149,3 +154,26 @@ setFTLConfigValue(){
         exit 1
     esac
 }
+
+#######################
+# Prints the local date and time of a Unix timestamp
+# GNU date takes -d @<seconds>, BSD date -r <seconds>
+#######################
+date_from_epoch() {
+  date -d @"${1}" 2>/dev/null || date -r "${1}"
+}
+
+#######################
+# Creates a temporary file in a directory, its name ending in a suffix
+# GNU mktemp has --suffix; elsewhere the random name is created first and
+# then given the suffix
+#######################
+mktemp_suffix() {
+  local tmp
+  if tmp="$(mktemp -p "${1}" --suffix="${2}" 2>/dev/null)"; then
+    echo "${tmp}"
+    return 0
+  fi
+  tmp="$(mktemp "${1}/tmp.XXXXXXXXXX")" || return 1
+  mv -n "${tmp}" "${tmp}${2}" && echo "${tmp}${2}"
+}
diff --git gravity.sh gravity.sh
index 1a78d8c2..b60f8d36 100755
--- gravity.sh
+++ gravity.sh
@@ -17,7 +17,11 @@ export LC_ALL=C
 # Without a terminal on stdin, mv replaces leftover root-owned files instead of prompting
 if [[ "${EUID}" -eq 0 ]]; then
   chown pihole:pihole /etc/pihole
-  exec sudo -u pihole bash "$0" "$@" </dev/null
+  if sudo -n -u pihole true 2>/dev/null; then
+    exec sudo -u pihole bash "$0" "$@" </dev/null
+  fi
+  # sudo refuses to run when root's own account is locked (FreeBSD: pw lock root)
+  exec su -m pihole -c 'exec bash "$0" "$@"' "$0" "$@" </dev/null
 fi
 
 PI_HOLE_SCRIPT_DIR="/opt/pihole"
@@ -133,9 +137,15 @@ gravity_swap_databases() {
   # Busybox Compat: `stat` long flags unsupported
   #   -f flag is short form of --file-system.
   #   -c flag is short form of --format.
-  availableBlocks=$(stat -f -c "%a" "${gravityDIR}")
-  # Number of blocks, used by gravity.db
-  gravityBlocks=$(stat -c "%b" "${gravityDBfile}")
+  if stat -c "%b" / >/dev/null 2>&1; then
+    availableBlocks=$(stat -f -c "%a" "${gravityDIR}")
+    # Number of blocks, used by gravity.db
+    gravityBlocks=$(stat -c "%b" "${gravityDBfile}")
+  else
+    # BSD stat: -f is the format, and it has no file-system mode
+    availableBlocks=$(df -P "${gravityDIR}" | awk 'NR == 2 {print $4}')
+    gravityBlocks=$(stat -f "%b" "${gravityDBfile}")
+  fi
   # Only keep the old database if available disk space is at least twice the size of the existing gravity.db.
   # Better be safe than sorry...
   oldAvail=false
@@ -198,11 +208,12 @@ database_table_from_file() {
   backup_path="${piholeDir}/migration_backup"
   backup_file="${backup_path}/$(basename "${2}")"
   # Create a temporary file with random filename with '.gravity' suffix.
-  # Note: '--suffix' requires GNU mktemp (coreutils), which is not pre-installed on Alpine, but it is installed as Pi-hole dependency.
-  tmpFile="$(mktemp -p "${GRAVITY_TMPDIR}" --suffix=".gravity")"
+  # mktemp_suffix() uses GNU mktemp's --suffix where it exists
+  tmpFile="$(mktemp_suffix "${GRAVITY_TMPDIR}" ".gravity")"
 
   local timestamp
-  timestamp="$(date --utc +'%s')"
+  # Seconds since the epoch are the same in every time zone
+  timestamp="$(date +'%s')"
 
   local rowid
   declare -i rowid
@@ -643,8 +654,8 @@ gravity_DownloadBlocklistFromUrl() {
 
   # Create temp file to store content on disk instead of RAM
   # Create a temporary file with random filename with '.phgpb' suffix.
-  # Note: '--suffix' requires GNU mktemp (coreutils), which is not pre-installed on Alpine, but it is installed as Pi-hole dependency.
-  listCurlBuffer=$(mktemp -p "${GRAVITY_TMPDIR}" --suffix=".phgpb")
+  # mktemp_suffix() uses GNU mktemp's --suffix where it exists
+  listCurlBuffer=$(mktemp_suffix "${GRAVITY_TMPDIR}" ".phgpb")
 
   # For all remote files, we try to determine if the file has changed to skip
   # downloading them whenever possible.
@@ -1139,7 +1150,8 @@ migrate_to_listsCache_dir() {
   if mv "${piholeDir}"/list.* "${listsCacheDir}/" 2>/dev/null; then
     migrated=true
     # Update the list's paths in the corresponding .sha1 files to the new location
-    sed -i "s|${piholeDir}/|${listsCacheDir}/|g" "${listsCacheDir}"/*.sha1 2>/dev/null
+    sed -i.tmp "s|${piholeDir}/|${listsCacheDir}/|g" "${listsCacheDir}"/*.sha1 2>/dev/null
+    rm -f "${listsCacheDir}"/*.sha1.tmp
   fi
 
   # The cache directory used to live in ${piholeDir}, but follows gravity.db now.
@@ -1149,7 +1161,8 @@ migrate_to_listsCache_dir() {
     if mv "${oldListsCacheDir}"/* "${listsCacheDir}/" 2>/dev/null; then
       migrated=true
       # The paths in the .sha1 files still point into the old cache directory
-      sed -i "s|${oldListsCacheDir}/|${listsCacheDir}/|g" "${listsCacheDir}"/*.sha1 2>/dev/null
+      sed -i.tmp "s|${oldListsCacheDir}/|${listsCacheDir}/|g" "${listsCacheDir}"/*.sha1 2>/dev/null
+      rm -f "${listsCacheDir}"/*.sha1.tmp
     fi
     # Remove the old directory, this only succeeds if it is empty
     rmdir "${oldListsCacheDir}" 2>/dev/null
