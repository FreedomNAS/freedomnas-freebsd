+    packagedFunc
   else
     if [[ "$2" == "-h" ]] || [[ "$2" == "--help" ]]; then
       echo "Switch Pi-hole subsystems to a different GitHub branch
@@ -471,6 +479,13 @@ unsupportedFunc(){
   exit 0
 }
 
+# A system package installed Pi-hole when its packaging leaves a "packaged"
+# file naming the package manager; that one updates and repairs it
+packagedFunc(){
+  echo "Pi-hole was installed with $(cat "${PI_HOLE_SCRIPT_DIR}/packaged"), use it to update, repair or remove Pi-hole"
+  exit 0
+}
+
 helpFunc() {
   echo "Usage: pihole [options]
 Example: 'pihole allow -h'
