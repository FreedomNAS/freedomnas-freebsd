From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sarahmeow1986 <saretta1986@proton.me>
Date: Thu, 22 Oct 2026 06:19:04 +0200
Subject: [PATCH] Support system packages: newsyslog, package versions and
 pkg-managed updates

---
 advanced/Scripts/piholeLogFlush.sh  |  9 +++++++--
 advanced/Scripts/updatecheck.sh     | 10 ++++++++++
 advanced/Scripts/utils.sh           | 13 +++++++++++++
 advanced/Templates/pihole.newsyslog |  6 ++++++
 gravity.sh                          |  4 ++--
 pihole                              | 15 +++++++++++++++
 6 files changed, 53 insertions(+), 4 deletions(-)
 create mode 100644 advanced/Templates/pihole.newsyslog

diff --git advanced/Scripts/piholeLogFlush.sh advanced/Scripts/piholeLogFlush.sh
index c380bb37..964c83ac 100755
--- advanced/Scripts/piholeLogFlush.sh
+++ advanced/Scripts/piholeLogFlush.sh
@@ -38,7 +38,7 @@ fi
 # The log paths come from the pihole-owned config, so never write to them as root
 as_pihole() {
     if [[ "${EUID}" -eq 0 ]]; then
-        sudo -u pihole "$@"
+        run_as_pihole "$@"
     else
         "$@"
     fi
@@ -68,7 +68,12 @@ if [[ "$*" == *"once"* ]]; then
     # Use logrotate's default state file so this run and the system's own
     # scheduled logrotate (which also reads /etc/logrotate.d/pihole) agree on
     # what's already been rotated, instead of rotating our logs twice.
-    /usr/sbin/logrotate --force /etc/logrotate.d/pihole
+    if [ -x /usr/sbin/logrotate ]; then
+        /usr/sbin/logrotate --force /etc/logrotate.d/pihole
+    else
+        # BSD rotates with newsyslog, which signals FTL to reopen its logs
+        newsyslog -F -f /usr/local/etc/newsyslog.conf.d/pihole.conf
+    fi
 else
     # Manual flushing
     flush_log "${LOGFILE}"
diff --git advanced/Scripts/updatecheck.sh advanced/Scripts/updatecheck.sh
index 80e86d36..6701c3c4 100755
--- advanced/Scripts/updatecheck.sh
+++ advanced/Scripts/updatecheck.sh
@@ -24,19 +24,29 @@ if [[ "$(id -u)" -eq 0 ]]; then
     exit "$?"
 fi
 
+# A system package ships no git checkout; its packaging leaves a .pkgversion
+# file with VERSION, BRANCH and HASH lines instead
+function get_package_value() {
+    [ -f "${1}/.pkgversion" ] || return 1
+    sed -n "s/^${2}=//p" "${1}/.pkgversion"
+}
+
 function get_local_branch() {
     # Return active branch
+    get_package_value "${1}" BRANCH && return
     cd "${1}" 2>/dev/null || { echo "null"; return; }
     git rev-parse --abbrev-ref HEAD || echo "null"
 }
 
 function get_local_version() {
     # Return active version
+    get_package_value "${1}" VERSION && return
     cd "${1}" 2>/dev/null || { echo "null"; return; }
     git describe --tags --always 2>/dev/null || echo "null"
 }
 
 function get_local_hash() {
+    get_package_value "${1}" HASH && return
     cd "${1}" 2>/dev/null || { echo "null"; return; }
     git rev-parse --short=8 HEAD || echo "null"
 }
diff --git advanced/Scripts/utils.sh advanced/Scripts/utils.sh
index 972d6b52..c8269684 100755
--- advanced/Scripts/utils.sh
+++ advanced/Scripts/utils.sh
@@ -189,3 +189,16 @@ mktemp_suffix() {
   tmp="$(mktemp "${1}/tmp.XXXXXXXXXX")" || return 1
   mv -n "${tmp}" "${tmp}${2}" && echo "${tmp}${2}"
 }
+
+#######################
+# Runs a command as the pihole user
+# sudo refuses to run when root's own account is locked (FreeBSD: pw lock
+# root), su does not care
+#######################
+run_as_pihole() {
+  if sudo -n -u pihole true 2>/dev/null; then
+    sudo -u pihole "$@"
+  else
+    su -m pihole -c 'exec "$0" "$@"' "$@"
+  fi
+}
diff --git advanced/Templates/pihole.newsyslog advanced/Templates/pihole.newsyslog
new file mode 100644
index 00000000..488feb5b
--- /dev/null
+++ advanced/Templates/pihole.newsyslog
@@ -0,0 +1,6 @@
+# newsyslog(8) configuration for Pi-hole, the counterpart of the logrotate
+# template: FTL reopens its logs on SIGUSR2 (31)
+# logfilename                      [owner:group]  mode count size when  flags [/pid_file] [sig_num]
+/var/log/pihole/pihole.log         pihole:pihole  640  5     *    @T00  ZC    /var/run/pihole-FTL.pid 31
+/var/log/pihole/FTL.log            pihole:pihole  640  3     *    $W0D0 ZC    /var/run/pihole-FTL.pid 31
+/var/log/pihole/webserver.log      pihole:pihole  640  3     *    $W0D0 ZC    /var/run/pihole-FTL.pid 31
diff --git gravity.sh gravity.sh
index b60f8d36..e9ea9ce5 100755
--- gravity.sh
+++ gravity.sh
@@ -774,7 +774,7 @@ gravity_DownloadBlocklistFromUrl() {
         if [ "$(id -un)" == "root" ]; then
             # If we are root, we need to check if the pihole user has read permission
             #  otherwise, we might read files that the pihole user should not be able to read
-            if sudo -u pihole test -r "${file_path}"; then
+            if run_as_pihole test -r "${file_path}"; then
                 echo -e "${OVER}  ${INFO} Using local file ${file_path}"
             else
                 echo -e "${OVER}  ${CROSS} Cannot read file (user 'pihole' lacks read permission)"
@@ -838,7 +838,7 @@ gravity_DownloadBlocklistFromUrl() {
         if [ "$(id -un)" == "root" ]; then
           # The buffer belongs to the calling user, only the read must happen as pihole
           # shellcheck disable=SC2024
-          sudo -u pihole cat -- "${file_path}" >"${listCurlBuffer}"
+          run_as_pihole cat -- "${file_path}" >"${listCurlBuffer}"
         else
           cat -- "${file_path}" >"${listCurlBuffer}"
         fi
